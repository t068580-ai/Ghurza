# You don't need to copy this by hand: `npm run dev` / `npm run setup` create .env
# for you and generate a fresh secret. This file just documents the variables.

DATABASE_URL="file:./dev.db"

# Open the app at exactly this address. Server Actions reject requests whose
# Origin header doesn't match it (CSRF protection).
APP_ORIGIN="http://localhost:3000"

# 64 hex characters, unique per install. Signs mock payment-provider callbacks.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET="<generated>"

# "true" enables the built-in mock checkout. Set "false" in any real deployment.
MOCK_PAYMENTS="true"

# Only set "true" when running behind a reverse proxy that sets X-Forwarded-For;
# otherwise the header is attacker-controlled and is ignored.
TRUST_PROXY="false"
